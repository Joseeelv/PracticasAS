FROM debian:latest

# Actualizar y instalar paquetes necesarios
RUN apt update && \
    apt install -y iputils-ping net-tools dnsutils nano ftp ssh

# Crear usuario con contraseña
RUN useradd -m user && \
    echo "user:user" | chpasswd && \
    echo "user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
