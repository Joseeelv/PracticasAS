# Configuración de MySQL
MYSQL_HOST=mysql
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=testdb

# Configuración de PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=testdb

# Configuración general
DB_TYPE=mysql  # Cambia a "pgsql" si quieres usar PostgreSQL
DB_HOST=mysql  # Cambia a "postgres" si usas PostgreSQL
DB_USER=root
DB_PASSWORD=root
DB_NAME=testdb
